# Copy to .env.local and fill in. .env.local is git-ignored.

# --- Browser (bundled into the app; never put secrets here) ---------------
# "mock" uses local mock data. Unset or "live" uses the n8n workflow via /api.
VITE_API_MODE=live

# --- Dev server only (used by the Vite proxy; never sent to the browser) ---
# Base URL of the Psycray webhooks on n8n, without a trailing slash.
# Production: https://<your-n8n-host>/webhook/psycray
# Testing in the n8n editor ("Listen for test event"): .../webhook-test/psycray
N8N_WEBHOOK_BASE=https://your-n8n-host/webhook/psycray

# Value of the Header Auth credential (header name: X-Psycray-Key) in n8n.
N8N_WEBHOOK_SECRET=
