    {
      "id": "50630e39-7c14-4c21-8dcf-a6609e082cbc",
      "name": "Load Companies",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        608
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Saved research, newest first (Overview, Saved Companies).\n-- One row out: { records: [...] } so the webhook returns a single JSON object.\nSELECT COALESCE(json_agg(c ORDER BY c.updated_at DESC), '[]'::json) AS records\nFROM (\n  SELECT id, domain, status, updated_at, company_facts, research_signals,\n         synthesized_research, sources, icp_score, icp_tier, icp_breakdown, account_brief\n  FROM company_research\n  ORDER BY updated_at DESC\n  LIMIT 200\n) c;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "V1HMewWXgQBIMFpN",
          "name": "Postgres account 6"
        }
      }
    },
    {
      "id": "cb12a57a-6afa-4ba0-9503-a07c727ac62c",
      "name": "Respond 200 Companies",
