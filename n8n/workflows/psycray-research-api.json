    {
      "id": "660254b0-bcbb-4a52-937d-deb1d06b3010",
      "name": "Load Research Job",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "alwaysOutputData": true,
      "position": [
        224,
        96
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Job status, joined with the stored research once the job has finished.\n-- Jobs stuck in 'running' for over 10 minutes are reported as failed.\nSELECT\n  j.id::text AS job_id,\n  CASE\n    WHEN j.status = 'running' AND j.created_at < NOW() - INTERVAL '10 minutes' THEN 'failed'\n    ELSE j.status\n  END AS status,\n  CASE\n    WHEN j.status = 'running' AND j.created_at < NOW() - INTERVAL '10 minutes' THEN 'Research took too long and was stopped.'\n    ELSE j.error\n  END AS error,\n  j.input,\n  j.domain,\n  j.created_at,\n  j.updated_at,\n  CASE WHEN j.status IN ('completed', 'cached') THEN to_jsonb(cr) END AS record\nFROM research_jobs j\nLEFT JOIN company_research cr ON cr.domain = j.domain\nWHERE j.id::text = $1;",
        "options": {
          "queryReplacement": "={{ [ $json.query.id || '' ] }}"
        }
      },
      "credentials": {
        "postgres": {
          "id": "V1HMewWXgQBIMFpN",
          "name": "Postgres account 6"
        }
      }
    },
    {
      "id": "13a77bd9-bcfc-40f2-ae45-373c01780a22",
      "name": "Was Job Found?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.3,
      "position": [
        448,
        96
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "loose",
            "version": 3
          },
          "conditions": [
            {
              "id": "9a051f1c-7c9c-42e5-b114-8c3b79bded0c",
              "leftValue": "={{ $json.job_id }}",
              "operator": {
                "type": "string",
                "operation": "exists",
                "singleValue": true
              },
              "rightValue": ""
            }
          ],
          "combinator": "and"
        },
        "looseTypeValidation": true,
        "options": {}
      }
    },
