    {
      "id": "d0a5b9ed-3771-40e8-b10d-30285a1d0b4e",
      "name": "Load Research Jobs",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2.7,
      "position": [
        224,
        800
      ],
      "parameters": {
        "operation": "executeQuery",
        "query": "-- Recent research requests and outcomes (Overview activity log).\n-- Jobs stuck in 'running' for over 10 minutes are reported as failed, as in /research/status.\nSELECT COALESCE(json_agg(j ORDER BY j.created_at DESC), '[]'::json) AS jobs\nFROM (\n  SELECT\n    id::text AS job_id,\n    CASE WHEN status = 'running' AND created_at < NOW() - INTERVAL '10 minutes' THEN 'failed' ELSE status END AS status,\n    input,\n    domain,\n    CASE WHEN status = 'running' AND created_at < NOW() - INTERVAL '10 minutes'\n         THEN 'Research took too long and was stopped.' ELSE error END AS error,\n    created_at\n  FROM research_jobs\n  ORDER BY created_at DESC\n  LIMIT 50\n) j;",
        "options": {}
      },
      "credentials": {
        "postgres": {
          "id": "V1HMewWXgQBIMFpN",
          "name": "Postgres account 6"
        }
      }
    },
    {
      "id": "2ee60eaa-12b8-4229-8386-4d34af72fdfd",
      "name": "Respond 200 Jobs",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1.1,
      "position": [
        448,
        800
      ],
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ { jobs: $json.jobs } }}",
        "options": {
          "responseCode": 200
        }
      }
    }
