      "html": "<nav class=\"ds-nav\"><a class=\"ds-nav-item\" href=\"#\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><rect x=\"3\" y=\"3\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"14\" y=\"3\" width=\"7\" height=\"5\" rx=\"1\"/><rect x=\"14\" y=\"12\" width=\"7\" height=\"9\" rx=\"1\"/><rect x=\"3\" y=\"16\" width=\"7\" height=\"5\" rx=\"1\"/></svg>Overview</a><a class=\"ds-nav-item\" aria-current=\"page\" href=\"#\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg>Company Research</a><a class=\"ds-nav-item\" href=\"#\"><svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\"><path d=\"M15 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V7Z\"/><path d=\"M14 2v4a2 2 0 0 0 2 2h4\"/></svg>Account Briefs</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:2px;width:224px;padding:8px;background:var(--sidebar,oklch(0.985 0 0));border-right:1px solid var(--sidebar-border,oklch(0.92 0.004 286.32))}.ds-nav-item{display:flex;align-items:center;gap:8px;height:32px;padding:0 8px;border-radius:calc(var(--radius,0.625rem)*0.8);font:400 13.5px 'Geist Variable',ui-sans-serif,system-ui,sans-serif;color:var(--sidebar-foreground,oklch(0.37 0.013 285.805));text-decoration:none;outline:none}.ds-nav-item svg{width:16px;height:16px;flex-shrink:0}.ds-nav-item:hover,.ds-nav-item[aria-current=page]{background:var(--sidebar-accent,oklch(0.92 0.004 286.32/.6));color:var(--sidebar-accent-foreground,oklch(0.141 0.005 285.823))}.ds-nav-item[aria-current=page]{font-weight:500}.ds-nav-item[aria-current=page] svg{color:var(--primary,oklch(0.45 0.17 274))}.ds-nav-item:focus-visible{box-shadow:0 0 0 2px var(--sidebar-ring,oklch(0.55 0.15 274))}"
