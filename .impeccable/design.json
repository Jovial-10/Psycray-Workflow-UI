  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "The page's one primary action, top-right of its first section.",
      "html": "<button class=\"ds-btn ds-btn-primary\"><svg xmlns=\"http://www.w3.org/2000/svg\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><circle cx=\"11\" cy=\"11\" r=\"8\"/><path d=\"m21 21-4.3-4.3\"/></svg>Research</button>",
      "css": ".ds-btn{display:inline-flex;align-items:center;justify-content:center;gap:8px;border-radius:calc(var(--radius,0.625rem)*0.8);font:500 14px/1 'Geist Variable',ui-sans-serif,system-ui,sans-serif;white-space:nowrap;border:1px solid transparent;cursor:pointer;transition:all .15s;outline:none}.ds-btn svg{width:16px;height:16px}.ds-btn:focus-visible{border-color:var(--ring,oklch(0.55 0.15 274));box-shadow:0 0 0 3px color-mix(in oklch,var(--ring,oklch(0.55 0.15 274)) 50%,transparent)}.ds-btn:disabled{opacity:.5;pointer-events:none}.ds-btn-primary{height:36px;padding:8px 16px;background:var(--primary,oklch(0.45 0.17 274));color:var(--primary-foreground,#fff)}.ds-btn-primary:hover{background:color-mix(in oklch,var(--primary,oklch(0.45 0.17 274)) 90%,transparent)}"
    },
    {
